SUPABASE_URL=https://xsslskkhxyavwvuxyelf.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
PUBLIC_SITE_URL=https://theharmonicity.com

# The real owner's Supabase auth user id (Authentication -> Users in the
# Supabase dashboard, or Table Editor -> auth.users). Not a secret -- it's
# already public in every synced media URL -- but it must be set correctly,
# in both places below, for editing lockdown to work:
#
# 1. api/public-portal.js requires this to serve the live public site. It
#    pins the query to this owner's portal_settings row only. Without it,
#    the endpoint fails closed (serves baked-in defaults) rather than
#    falling back to "whichever row was updated most recently, any owner" --
#    that old behavior let anyone who signed up for a Supabase account
#    overwrite what every visitor sees.
# 2. owner-gate.js (client-side, via /api/config) uses this to decide
#    whether to reveal the Edit / Customize / Connect Cloud buttons for the
#    current visitor's session. Everyone else never sees them.
#
# Candidate value derived from the existing DEFAULT_MEDIA_BASE upload path
# already baked into app.js (Supabase Storage paths are `{owner_id}/...`) --
# confirm this against the Supabase dashboard before relying on it:
OWNER_ID=b7387b68-4169-4c9b-a4cc-64d576cdeca8

# Optional. Powers /api/public-portal, which lets the live site (colors, hero
# text, world copy, background/intro/core/audio media) update automatically
# whenever the owner syncs a change from Creator Studio -- no redeploy needed.
# Without it, every visitor still gets the correct baked-in defaults from
# app.js; they just won't reflect changes made after that code was deployed.
#
# This is the Supabase project's SERVICE ROLE key (Project Settings -> API).
# It bypasses row-level security entirely -- treat it like a root password:
# never commit it, never put it in client-side code, never log it. It is only
# ever read server-side in api/public-portal.js, which returns nothing but
# the same non-secret settings JSON that already determines page content.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
