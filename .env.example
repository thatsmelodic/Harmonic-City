SUPABASE_URL=https://xsslskkhxyavwvuxyelf.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
PUBLIC_SITE_URL=https://theharmonicity.com

# Optional. Powers /api/public-portal, which lets the live site (colors, hero
# text, world copy, background/intro/core/audio media) update automatically
# whenever the owner syncs a change from Creator Studio -- no redeploy needed.
# Without it, every visitor still gets the correct baked-in defaults from
# app.js; they just won't reflect changes made after that code was deployed.
#
# This is the Supabase project's SERVICE ROLE key (Project Settings -> API).
# It bypasses row-level security entirely -- treat it like a root password:
# never commit it, never put it in client-side code, never log it. It is only
# ever read server-side in api/public-portal.js, which returns nothing but
# the same non-secret settings JSON that already determines page content.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
